{
  "version": "2.0",
  "last_updated": "2026-06-25",
  "auteur": "Ali Djellalil",
  "objet": "Dictionnaire des DONNEES (datas / colonnes). La cle de chaque entree est un id canonique du concept metier, independant du nom variable porte dans chaque fichier source. C'est la cle de jointure : sources.json y fait reference via colonnes[].data_ref ; livrables.json via datas_produites.",
  "conventions": {
    "id_canonique": "Cle en MAJUSCULES, stable. Le meme concept (ex. IBAN, ID_RP) peut apparaitre dans plusieurs sources.",
    "familles": "identifiant | acteur | compte | geographie | classification | worldline | monetaire | flux_pnb | kpi | temporel | override",
    "calculee": "true = donnee produite par un livrable (non presente telle quelle dans une source brute). Voir depends_on / produite_par.",
    "a_remplir": "Valeur 'a_remplir' = a completer par Ali (sens metier exact, format, exemple reel)."
  },

  "datas": {

    "ID_RP":        {"libelle": "Identifiant Relation Personne (RP)", "famille": "identifiant", "definition": "Cle client unique (Relation Personne) — pivot principal Monext/Worldline.", "format": "string", "exemple": "030004000000706", "alias": ["identifiant_RP", "ID unique", "ID_RP_PERS", "IDRP", "ID RP EJ"], "notes": "Sacralise =\"...\" en Excel pour preserver les zeros. Variantes scientifiques (3,3E+15) a renormaliser.", "calculee": false},
    "ID_RC":        {"libelle": "Identifiant Relation Commerciale (RC)", "famille": "identifiant", "definition": "Identifiant Referentiel/Relation Commerciale Worldline, 17 chiffres.", "format": "string", "exemple": "02511770435482310", "alias": ["identifiant_RC", "N° Relation commerciale", "RC", "ID_RP_RC"], "notes": "Zero-padding a 17. Normalise avec/sans zeros initiaux.", "calculee": false},
    "RMPM":         {"libelle": "Identifiant entite RMPM", "famille": "identifiant", "definition": "Identifiant entite juridique (RMPM) — cle geographie/entite.", "format": "string", "exemple": "4ABG297680", "alias": ["identifiant_RMPM", "ID_RMPM", "RMPM EJ Cliente", "ID_RMPM_PERS"], "notes": "", "calculee": false},
    "ID_PROG":      {"libelle": "Identifiant programme Worldline", "famille": "identifiant", "definition": "Identifiant programme Worldline (CPC).", "format": "string", "exemple": "4821", "alias": ["programme_id", "ID Programme", "ID_PROGRAMME"], "notes": "4-5 chiffres. Jointure PRGM col4 = ACHETEUR col1.", "calculee": false},
    "ID_FDC":       {"libelle": "Identifiant Fonds De Commerce (FDC)", "famille": "identifiant", "definition": "Identifiant portefeuille / fonds de commerce.", "format": "string", "exemple": "02323CA2502", "alias": ["identifiant_FDC", "ID_RP_FDC", "Portfolio_ID"], "notes": "", "calculee": false},
    "BUSINESS_GROUP_ID": {"libelle": "Business Group ID", "famille": "identifiant", "definition": "Identifiant groupe d'affaires (referentiel IBAN groupe).", "format": "string", "exemple": "HYAAL", "alias": ["Business Group ID"], "notes": "", "calculee": false},
