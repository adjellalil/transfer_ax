    "IDENTIFIANT_POLYMORPHE": {"libelle": "Valeur d'identifiant polymorphe", "famille": "identifiant", "definition": "Valeur de l'identifiant dont le type est donne par TYPE_IDENTIFIANT.", "format": "string", "exemple": "00039590430401073", "alias": ["identifiant_polymorphe", "IDENTIFIANT", "Valeur identifiant"], "notes": "", "calculee": false},

