{
  "version": "1.0",
  "last_updated": "2026-06-23",
  "_note": "Amorce par analyse des scripts. Définitions marquées \"a_remplir\" à compléter par Ali (sens métier exact).",
  "columns_source": {
    "ID_RC": {"definition": "Identifiant Référentiel Client (RC) Worldline, 17 chiffres.", "format": "string", "exemple": "12345678901234567", "sources_utilisees": ["PRGM", "PARC_CLIENT", "REFERENTIEL_CLIENT", "MONEXT"], "notes": "Normalisé avec/sans zéros initiaux."},
    "ID_RP": {"definition": "Identifiant Relation Personne (RP) — clé client Monext.", "format": "string", "exemple": "987654321", "sources_utilisees": ["MONEXT", "PARC_CLIENT", "REFERENTIEL_CLIENT", "CCO_FLUX", "CCO_STOCK"], "notes": "Sacralisé =\"...\" en Excel."},
    "ID_PROG": {"definition": "Identifiant programme Worldline.", "format": "string", "exemple": "4821", "sources_utilisees": ["PRGM", "MATCHING_USAGE", "MC1", "MC2"], "notes": "4-5 chiffres."},
    "RMPM": {"definition": "Identifiant entité (RMPM) — clé géographie/entité juridique.", "format": "string", "exemple": "a_remplir", "sources_utilisees": ["PARC_CLIENT", "REFERENTIEL_CLIENT", "IBAN_ACCOUNT", "REBATE"], "notes": "a_remplir"},
    "IBAN": {"definition": "Numéro de compte bancaire international.", "format": "string", "exemple": "FR7630003000040000000000000", "sources_utilisees": ["PRGM", "MONEXT", "PARC_CLIENT", "IBAN_ACCOUNT", "OPTIFLUX"], "notes": "Variantes courte (7) / complète (24)."},
    "RS": {"definition": "Raison Sociale (nom d'entreprise).", "format": "string", "exemple": "ACME FRANCE SAS", "sources_utilisees": ["PRGM", "MONEXT", "PARC_CLIENT", "REFERENTIEL_CLIENT", "OPTIFLUX"], "notes": "Normalisée (sans ponctuation/accents/casse) pour le matching."},
    "MOIS": {"definition": "Mois de la donnée.", "format": "string", "exemple": "202501", "sources_utilisees": ["PRGM", "MONEXT", "CCO_FLUX", "CCO_STOCK", "DEVISES"], "notes": "Format YYYYMM, parsé en label."},
    "CODE_AGENCE": {"definition": "Code agence BNP.", "format": "string", "exemple": "a_remplir", "sources_utilisees": ["PRGM", "MONEXT", "PARC_CLIENT", "BPE_RETAIL", "SEG_AGENCE"], "notes": "Numérique, normalisé."},
    "PRODUIT": {"definition": "Produit carte.", "format": "string", "exemple": "a_remplir", "sources_utilisees": ["PRGM", "MATCHING_USAGE", "MC1", "MC2"], "notes": "Normalisé majuscule."},
    "MONTANT": {"definition": "Montant de transaction (générique).", "format": "decimal", "exemple": "12500.50", "sources_utilisees": ["PRGM", "MONEXT", "CCO_FLUX", "REBATE"], "notes": "Converti float, EUR final via DEVISES."},
    "NB_CARTES": {"definition": "Nombre de cartes.", "format": "integer", "exemple": "120", "sources_utilisees": ["PRGM", "MONEXT"], "notes": "Moyenné sur la période."},
    "DEVISE": {"definition": "Code devise (ISO 3 lettres).", "format": "string", "exemple": "EUR", "sources_utilisees": ["PRGM", "REFERENTIEL_CLIENT", "DEVISES"], "notes": ""},
    "PLAFOND": {"definition": "Plafond de la transaction/programme.", "format": "decimal", "exemple": "a_remplir", "sources_utilisees": ["PRGM"], "notes": "Proxy d'activité."},
    "PERIODICITE": {"definition": "Périodicité de paiement.", "format": "string", "exemple": "a_remplir", "sources_utilisees": ["PRGM"], "notes": "a_remplir"},
    "DIFFERE": {"definition": "Indicateur/flag de différé de paiement.", "format": "string", "exemple": "a_remplir", "sources_utilisees": ["PRGM", "MONEXT"], "notes": "a_remplir"},
    "SIREN": {"definition": "Numéro SIREN (immatriculation entreprise).", "format": "string", "exemple": "123456789", "sources_utilisees": ["PARC_CLIENT", "REFERENTIEL_CLIENT"], "notes": "9 chiffres."},
    "SEGMENT": {"definition": "Segment client (ENT/BPE et sous-segments).", "format": "string", "exemple": "ENT", "sources_utilisees": ["PARC_CLIENT", "REFERENTIEL_CLIENT", "IDENTIFIANT_SEGMENT"], "notes": "Dérivé/mappé."},
    "CATEGORIE": {"definition": "Catégorie client (ENTREPRISE/BPE).", "format": "string", "exemple": "ENTREPRISE", "sources_utilisees": ["REFERENTIEL_CLIENT"], "notes": "a_remplir"},
    "GROUPE_AFFAIRES": {"definition": "Groupe d'affaires (unité d'organisation).", "format": "string", "exemple": "a_remplir", "sources_utilisees": ["MONEXT"], "notes": "a_remplir"},
    "DEPENSES": {"definition": "Dépenses/achats carte.", "format": "decimal", "exemple": "a_remplir", "sources_utilisees": ["MONEXT"], "notes": "Composante du FLUX."},
    "RETRAITS": {"definition": "Retraits espèces carte.", "format": "decimal", "exemple": "a_remplir", "sources_utilisees": ["MONEXT"], "notes": "Composante du FLUX."},
    "NOM_GA": {"definition": "Nom du gestionnaire/agence (GA).", "format": "string", "exemple": "a_remplir", "sources_utilisees": ["PARC_CLIENT", "REFERENTIEL_CLIENT", "IBAN_ACCOUNT"], "notes": "a_remplir"},
    "NOM_ENTITE": {"definition": "Nom de l'entité juridique.", "format": "string", "exemple": "a_remplir", "sources_utilisees": ["IBAN_ACCOUNT"], "notes": "a_remplir"},
    "TAUX": {"definition": "Taux de change vers EUR.", "format": "decimal", "exemple": "1.0857", "sources_utilisees": ["DEVISES"], "notes": "Par DATE (YYYYMM) et CODE devise."}
  },
  "columns_calculees": {
    "FLUX": {"definition": "Flux total = DEPENSES + RETRAITS.", "format": "decimal", "exemple": "a_remplir", "depends_on": ["DEPENSES", "RETRAITS"], "produced_by": ["BNP_LIV_036", "BNP_LIV_019"], "formula_description": "depenses + retraits", "notes": ""},
    "PNB_TOTAL": {"definition": "PNB total (somme des composantes PNB).", "format": "decimal", "exemple": "a_remplir", "depends_on": ["PNB_CORPORATE", "PNB_NDF", "PNB_INTEREST", "PNB_COMMISSION"], "produced_by": ["BNP_LIV_018", "BNP_LIV_019", "BNP_LIV_036"], "formula_description": "Somme d'une plage de colonnes PNB (ex. 19-55 hors colonne 33 pour Monext).", "notes": "a_remplir"},
    "SEGMENT_SOURCE": {"definition": "Source ayant déterminé le segment (REF_RC, REF_IBAN, IDSEG_RC, FALLBACK...).", "format": "string", "exemple": "REF_RC", "depends_on": ["SEGMENT"], "produced_by": ["BNP_LIV_018", "BNP_LIV_019"], "formula_description": "Hiérarchie de matching tracée.", "notes": ""},
    "SEGMENT_RAW": {"definition": "Valeur de segment brute avant normalisation.", "format": "string", "exemple": "a_remplir", "depends_on": ["SEGMENT"], "produced_by": ["BNP_LIV_018", "BNP_LIV_019"], "formula_description": "a_remplir", "notes": ""},
    "GEO_GA": {"definition": "Région géographique du GA (France / Hors_France / Pays_non_trouve).", "format": "string", "exemple": "France", "depends_on": ["PAYS_GA"], "produced_by": ["BNP_LIV_018", "BNP_LIV_019", "BNP_LIV_024"], "formula_description": "pays_to_geo(PAYS_GA)", "notes": ""},
    "PAYS_GA": {"definition": "Pays du GA (via IBAN_ACCOUNT/géo).", "format": "string", "exemple": "FRANCE", "depends_on": ["CODE_GA", "RMPM"], "produced_by": ["BNP_LIV_018", "BNP_LIV_019", "BNP_LIV_024"], "formula_description": "a_remplir", "notes": ""},
    "ENTREPRISE": {"definition": "Flag classification ENTREPRISE (YES/NO).", "format": "string", "exemple": "YES", "depends_on": ["SEGMENT"], "produced_by": ["BNP_LIV_018", "BNP_LIV_019"], "formula_description": "a_remplir", "notes": ""},
    "BPE": {"definition": "Flag classification BPE (YES/NO).", "format": "string", "exemple": "NO", "depends_on": ["SEGMENT"], "produced_by": ["BNP_LIV_018", "BNP_LIV_019"], "formula_description": "a_remplir", "notes": ""},
    "FOUND_PARC": {"definition": "Flag de matching trouvé dans PARC_CLIENT (YES/NO/N/A).", "format": "string", "exemple": "YES", "depends_on": ["ID_RP", "ID_RC"], "produced_by": ["BNP_LIV_018", "BNP_LIV_019"], "formula_description": "Indicateur de réussite de jointure.", "notes": "Existe aussi FOUND_ACCOUNT/OPTIFLUX/YANNICK/MC1/MC2/BPE_RETAIL."},
    "DIAGNOSTIC": {"definition": "Trace détaillée du chemin de résolution/matching.", "format": "string", "exemple": "a_remplir", "depends_on": [], "produced_by": ["BNP_LIV_018", "BNP_LIV_033", "BNP_LIV_034"], "formula_description": "Énumération des tentatives.", "notes": ""},
    "USAGE": {"definition": "Usage produit (depuis MATCHING_USAGE, fallback PRODUIT).", "format": "string", "exemple": "a_remplir", "depends_on": ["PRODUIT", "ID_PROG"], "produced_by": ["BNP_LIV_017", "BNP_LIV_018"], "formula_description": "map MATCHING_USAGE sinon PRODUIT.", "notes": ""},
    "FLUX_2025": {"definition": "Flux annuel 2025.", "format": "decimal", "exemple": "a_remplir", "depends_on": ["FLUX", "MOIS"], "produced_by": ["BNP_LIV_029", "BNP_LIV_030"], "formula_description": "Somme FLUX sur les mois 2025.", "notes": "Idem FLUX_2026, PNB_2025, PNB_2026."},
    "ID_RC_FINAL": {"definition": "RC résolu final (LIV_033).", "format": "string", "exemple": "a_remplir", "depends_on": ["ID_RC"], "produced_by": ["BNP_LIV_033"], "formula_description": "Sortie du pipeline de résolution RC.", "notes": "Avec RS_FINAL, RMPM_FINAL, NOM_ENTITE_JURIDIQUE."},
    "COMMISSION_TOTAL_HT": {"definition": "Commission totale HT (LIV_035).", "format": "decimal", "exemple": "a_remplir", "depends_on": ["MONTANT", "REBATE"], "produced_by": ["BNP_LIV_035"], "formula_description": "a_remplir", "notes": ""},
    "ALERTE_BAISSE": {"definition": "Alerte de baisse de flux (OUI/NON).", "format": "string", "exemple": "OUI", "depends_on": ["FLUX"], "produced_by": ["BNP_LIV_032"], "formula_description": "a_remplir", "notes": ""}
  }
}
